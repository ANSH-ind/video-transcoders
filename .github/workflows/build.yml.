name: Linux PyPI Publish

on:
  release:
    types: [published]
  workflow_dispatch:

jobs:
  build_linux:
    name: Build Linux Wheel
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4
      
      - name: Build Linux wheels
        uses: pypa/cibuildwheel@v2.21.3
        env:
          CIBW_PROJECT_REQUIRES_PYTHON: ">=3.9"
          CIBW_BUILD: "cp39-* cp310-* cp311-* cp312-*"
          CIBW_SKIP: "cp38-* *-musllinux* pp*"
          
          # Linux ke liye modern manylinux image taaki naya FFmpeg support mile
          CIBW_MANYLINUX_X86_64_IMAGE: quay.io/pypa/manylinux_2_34_x86_64
          CIBW_MANYLINUX_AARCH64_IMAGE: quay.io/pypa/manylinux_2_34_aarch64
          
          CIBW_BEFORE_ALL_LINUX: >
            dnf install -y epel-release &&
            dnf install -y 'dnf-command(config-manager)' &&
            dnf config-manager --set-enabled crb &&
            dnf install -y --nogpgcheck https://mirrors.rpmfusion.org/free/el/rpmfusion-free-release-9.noarch.rpm &&
            dnf install -y ffmpeg-devel pkgconf-pkg-config

      - name: Upload Linux wheel artifact
        uses: actions/upload-artifact@v4
        with:
          name: cibw-linux-wheel
          path: ./wheelhouse/*.whl

  upload_pypi:
    name: Upload to PyPI
    needs: [build_linux]
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      
      - name: Download Linux wheel
        uses: actions/download-artifact@v4
        with:
          name: cibw-linux-wheel
          path: dist
          
      - name: Publish package to PyPI
        uses: pypa/gh-action-pypi
