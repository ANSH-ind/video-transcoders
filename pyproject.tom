[build-system]
requires = ["scikit-build-core", "pybind11"]
build-backend = "scikit_build_core.build"

[project]
name = "video-transcoders"
version = "0.1.0"
description = "Video transcoders library using FFmpeg and pybind11"
readme = "README.md"
requires-python = ">=3.8"
authors = [
    { name = "Ansh Raj", email = "ansh0000000001@gmail.com" }
]
dependencies = []

[tool.scikit-build]
cmake.build-type = "Release"

